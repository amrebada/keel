{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Keel plugin.yaml",
  "type": "object",
  "required": [
    "id",
    "version",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "tags": {
      "type": "array",
      "description": "Search words beyond the summary, e.g. payments, subscriptions.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "maxItems": 12
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "sql",
              "kv",
              "cache",
              "http-client",
              "secrets",
              "crypto",
              "log",
              "email"
            ]
          }
        },
        "plugins": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(GET|POST|PUT|PATCH|DELETE) /\\S*$"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "consumes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "config": {
      "type": "string"
    },
    "runtime_config": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "migrations": {
      "type": "string"
    },
    "setup": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "external-account",
              "secret",
              "dns",
              "webhook",
              "manual"
            ]
          },
          "when": {
            "type": "string",
            "pattern": "^config(\\.[A-Za-z0-9_-]+)+$"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "produces": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^secret:[A-Z][A-Z0-9_]*$"
            }
          },
          "requires_paid_account": {
            "type": "boolean"
          },
          "verify": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "secret-present",
                  "plugin-check",
                  "manual"
                ]
              },
              "keys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                }
              }
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^((GET|POST|PUT|PATCH|DELETE) )?/\\S*$"
            }
          }
        }
      }
    },
    "degrade_level": {
      "enum": [
        "info",
        "warn",
        "error"
      ],
      "description": "How much this plugin being down matters to /health. Default error."
    }
  }
}
